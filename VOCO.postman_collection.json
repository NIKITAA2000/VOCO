    {
      "name": "03. Universal Invites (User & Guest)",
      "item": [
        {
          "name": "Join via Invite (User 2 - Auth)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.collectionVariables.set('sessionIdUser2', json.sessionId);",
                  "    console.log('User 2 joined via invite. Role:', json.role);",
                  "    pm.test('Role should be PARTICIPANT', function() {",
                  "        pm.expect(json.role).to.eql('PARTICIPANT');",
