      "name": "05. Moderation",
      "item": [
        {
          "name": "Promote User 2 to Moderator",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenOwner}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"MODERATOR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/rooms/{{roomSlug}}/participants/{{userIdUser2}}/role",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "rooms",
                "{{roomSlug}}",
                "participants",
                "{{userIdUser2}}",
                "role"
              ]
            }
          },
          "response": []
