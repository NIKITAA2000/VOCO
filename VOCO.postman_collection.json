        {
          "name": "Try Join Deleted Invite - SHOULD FAIL",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 400) {",
                  "    const json = pm.response.json();",
                  "    console.log('Correctly rejected deleted invite:', json.error);",
                  "    pm.test('Error mentions deactivated/expired', function() {",
                  "        pm.expect(json.error).to.include('деактивирована');",
                  "    });",
                  "} else {",
                  "    console.error('❌ FAILED: Expected 400 but got', pm.response.code);",
